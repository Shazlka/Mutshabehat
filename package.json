{
  "name": "mutshabehat-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mushaf:dev": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" next dev --hostname 127.0.0.1 --port 3000",
    "mushaf:runtime": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/check-mushaf1441-preview-runtime.mjs",
    "mushaf:validate": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-objective.mjs && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-page-order.mjs && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-page-words.mjs && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-navigation.mjs && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-supabase-interactions.mjs && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-page-ayats.mjs && PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/validate-mushaf1441-phase6.mjs",
    "mushaf:supabase": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/check-mushaf1441-supabase-env.mjs",
    "mushaf:supabase:crud": "PATH=\"/opt/homebrew/opt/node@22/bin:$PATH\" node scripts/verify-mushaf1441-supabase-crud.mjs",
    "test:proxy": "tsx --test tests/proxy-autologin.test.mjs",
    "test:qiraat": "node packages/qiraat-core/validate.mjs && tsx --test packages/qiraat-core/engine.test.mjs && node scripts/validate-qiraat-data.mjs && npm run qiraat:frontend:validate",
    "test:qiraat:review": "tsx --test tests/qiraat/review-http.test.ts",
    "qiraat:validate": "node scripts/validate-qiraat-data.mjs",
    "qiraat:audit": "node scripts/qiraat/audit-qiraat-pages.mjs",
    "qiraat:frontend:validate": "tsx scripts/qiraat/validate-qiraat-frontend.mts",
    "qiraat:canonical-words:validate": "tsx scripts/qiraat/seed-canonical-words.ts --check",
    "test:qiraat:batch": "bash scripts/qiraat/test-batch-rollback.sh",
    "typecheck": "tsc --noEmit -p .",
    "test:quiz": "tsx --test tests/quiz/engine.test.ts tests/quiz/presentation.test.ts",
    "test:quiz:integration": "tsx --env-file=.env.local --test tests/quiz/database.test.ts",
    "test:quiz:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@types/sanitize-html": "^2.16.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "exceljs": "^4.4.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.4",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-drag": "^3.0.0",
    "@types/d3-force": "^3.0.0",
    "@types/d3-interpolate": "^3.0.0",
    "@types/d3-selection": "^3.0.0",
    "@types/d3-transition": "^3.0.0",
    "@types/d3-zoom": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "ws": "^8.21.0"
  }
}
