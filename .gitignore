# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify output
graphify-out/

# Python bytecode from the Qiraat generators (committed by accident in 7b54c40)
__pycache__/
*.pyc

# Local browser verification artifacts
/playwright-report/
/test-results/

# Local build & experimentation artifacts
.ai/
apps/**/.build/
scratch/

# Superseded local output location from early Qiraat audit development.
/artifacts/qiraat-audit/
